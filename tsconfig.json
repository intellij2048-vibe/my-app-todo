{
    "compilerOptions": {
      "moduleResolution": "node", // node로 설정되어 있는지 확인
      // ... 기타 설정
      "baseUrl": ".", 
      "paths": {
        "@/*": ["./src/*"] 
      },
      "allowImportingTsExtensions": false, // true일 경우 오히려 확장자를 강제하므로 false여야 함
      "resolveJsonModule": true,
      "isolatedModules": true,
      "noEmit": true,
      "jsx": "preserve"
    },
    "include": [
      "next-env.d.ts",
      "**/*.ts",
      "**/*.tsx",
      ".next/types/**/*.ts" // 필수
    ],
    "exclude": ["node_modules"]
  }
  